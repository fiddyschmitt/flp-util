<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- FileLocator Pro is Windows-only, and we read its config out of HKCU. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>flp-util</AssemblyName>
    <RootNamespace>FlpUtil</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.8.0-beta is the only Lucene.NET line that ships the read-only Lucene3x
         codec, which is what an FLP (Lucene++ 3.0) index needs. -->
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
  </ItemGroup>

</Project>
